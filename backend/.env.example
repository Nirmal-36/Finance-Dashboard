# --- Database ---
DATABASE_URL=postgresql+psycopg2://financelens:financelens@localhost:5432/financelens

# --- JWT Auth ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google Gemini (AI categorization) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=15
UPLOAD_DIR=./uploads

# --- Device ingestion (Android Accessibility Service) ---
DEVICE_API_KEY_SALT=change-me-too
# Encrypts device API keys at rest (needed for pairing codes). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DEVICE_KEY_ENCRYPTION_SECRET=change-me-to-a-long-random-string
PAIRING_CODE_TTL_SECONDS=180
